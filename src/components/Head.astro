---
import Default from '@astrojs/starlight/components/Head.astro'
import { EXTENSIONS, SITE } from '../data/extensions.mjs'

// Generated extension pages may set their own og:image in frontmatter `head`
// (scripts/sync-extensions.mjs); every other page gets the site-wide image.
const ogImage = `${SITE}/og.png`
const hasOwnOgImage = Astro.locals.starlightRoute.head.some(
    ({ attrs, tag }) => tag === 'meta' && attrs?.property === 'og:image',
)
const isHomePage = Astro.url.pathname === '/'
---

<Default><slot /></Default>
<link href="/llms.txt" rel="alternate" type="text/plain" title="llms.txt" />
{
    !hasOwnOgImage && (
        <>
            <meta property="og:image" content={ogImage} />
            <meta property="og:image:width" content="1200" />
            <meta property="og:image:height" content="630" />
            <meta name="twitter:image" content={ogImage} />
        </>
    )
}
{
    isHomePage && (
        <script
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'ItemList',
                itemListElement: EXTENSIONS.map(({ label, slug }, index) => ({
                    '@type': 'ListItem',
                    name: label,
                    position: index + 1,
                    url: `${SITE}/${slug}/`,
                })),
                name: 'Spicetify extensions',
                url: SITE,
            })}
        />
    )
}
