---
import Default from '@astrojs/starlight/components/Head.astro'
import extensions from '../data/extensions.generated.json'
import { EXTENSIONS, SITE } from '../data/extensions.mjs'

// An extension's pages (overview and changelog) share its Marketplace preview image.
// Previews come in whatever size each repo ships, so dimensions are only declared
// for the site-wide fallback.
const slug = Astro.locals.starlightRoute.id.split('/')[0]
const preview = extensions.find((extension) => extension.slug === slug)?.preview
const ogImage = preview ?? `${SITE}/og.png`
const isHomePage = Astro.url.pathname === '/'
---

<Default><slot /></Default>
<link href="/llms.txt" rel="alternate" type="text/plain" title="llms.txt" />
<meta property="og:image" content={ogImage} />
{
    !preview && (
        <>
            <meta property="og:image:width" content="1200" />
            <meta property="og:image:height" content="630" />
        </>
    )
}
<meta name="twitter:image" content={ogImage} />
{
    isHomePage && (
        <script
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'ItemList',
                itemListElement: EXTENSIONS.map(({ label, slug }, index) => ({
                    '@type': 'ListItem',
                    name: label,
                    position: index + 1,
                    url: `${SITE}/${slug}/`,
                })),
                name: 'Spicetify extensions',
                url: SITE,
            })}
        />
    )
}
