---
import extensions from '../data/extensions.generated.json'
---

<section class="shelf" aria-labelledby="extensions-heading">
    <h2 id="extensions-heading">Extensions</h2>
    <ul class="grid">
        {
            extensions.map((extension) => (
                <li>
                    <a class="card" href={`/${extension.slug}/`}>
                        <div class="cover">
                            {extension.preview ? (
                                <img alt="" height="300" loading="lazy" src={extension.preview} width="300" />
                            ) : (
                                <span class="fallback" aria-hidden="true">
                                    {extension.name.charAt(0)}
                                </span>
                            )}
                            <span class="open" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M5 12h14M13 6l6 6-6 6" />
                                </svg>
                            </span>
                        </div>
                        <h3>{extension.name}</h3>
                        <p class="description">{extension.description}</p>
                        {extension.version && <span class="version">v{extension.version}</span>}
                    </a>
                </li>
            ))
        }
    </ul>
</section>

<style>
    .shelf {
        margin-top: 2rem;
    }
    h2 {
        font-size: var(--sl-text-2xl);
        font-weight: 800;
        margin: 0 0 1rem;
    }
    .grid {
        display: grid;
        gap: 1.25rem;
        grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
        list-style: none;
        margin: 0;
        padding: 0;
    }
    .card {
        background: var(--sl-color-gray-7);
        border-radius: 0.5rem;
        color: var(--sl-color-white);
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        height: 100%;
        padding: 1rem;
        text-decoration: none;
        transition: background-color 0.2s;
    }
    .card:hover,
    .card:focus-visible {
        background: var(--sl-color-gray-6);
    }
    .cover {
        aspect-ratio: 1;
        background: var(--sl-color-gray-6);
        border-radius: 0.5rem;
        box-shadow: 0 8px 24px rgb(0 0 0 / 0.3);
        overflow: hidden;
        position: relative;
    }
    .cover img {
        display: block;
        height: 100%;
        object-fit: cover;
        object-position: top left;
        width: 100%;
    }
    .fallback {
        align-items: center;
        background: linear-gradient(135deg, var(--sl-color-accent-low), var(--sl-color-accent));
        color: var(--sl-color-white);
        display: flex;
        font-size: 4rem;
        font-weight: 800;
        height: 100%;
        justify-content: center;
    }
    .open {
        align-items: center;
        background: var(--sl-color-accent);
        border-radius: 50%;
        bottom: 0.5rem;
        box-shadow: 0 8px 8px rgb(0 0 0 / 0.3);
        color: #000;
        display: flex;
        height: 3rem;
        justify-content: center;
        opacity: 0;
        position: absolute;
        right: 0.5rem;
        transform: translateY(0.5rem);
        transition:
            opacity 0.2s,
            transform 0.2s;
        width: 3rem;
    }
    .card:hover .open,
    .card:focus-visible .open {
        opacity: 1;
        transform: none;
    }
    h3 {
        font-size: var(--sl-text-lg);
        font-weight: 700;
        margin: 0.25rem 0 0;
    }
    .description {
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        color: var(--sl-color-gray-2);
        display: -webkit-box;
        font-size: var(--sl-text-sm);
        margin: 0;
        overflow: hidden;
    }
    .version {
        align-self: flex-start;
        background: var(--sl-color-gray-5);
        border-radius: 500px;
        color: var(--sl-color-white);
        font-size: var(--sl-text-xs);
        font-weight: 700;
        margin-top: auto;
        padding: 0.125rem 0.625rem;
    }
    @media (prefers-reduced-motion: reduce) {
        .card,
        .open {
            transition: none;
        }
    }
</style>
